# deeper-research — environment template. Copy to ~/.env (or ./.env) and fill in.
# NEVER commit a filled-in copy; .gitignore excludes .env and .env.* (this .example is the one exception).

# --- Round-1 retrieval (REQUIRED for the slices pipeline) ---
EXA_API_KEY=

# --- Synthesis / adversary LLM providers (set at least one; families: anthropic/openai/google/xai) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=

# --- Academic anchor ---
# RECOMMENDED — OpenAlex now meters every request; keyless use gets only a tiny daily
# allowance and lookups will 429 mid-run. Free key ($1/day): openalex.org/signup, then
# copy it from openalex.org/settings/api-key
OPENALEX_KEY=
# OPTIONAL — raises Semantic Scholar (fallback) rate limits
SEMANTIC_SCHOLAR_KEY=

# --- OPTIONAL — a contact email sent in OpenAlex/Crossref User-Agent (polite-pool, faster) ---
CONTACT_EMAIL=
